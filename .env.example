# SignalFlow configuration template — copy to .env and fill in.
# Keys live ONLY in .env (never committed). Real values live in ~/.secrets.

# Opencode go router (OpenAI-compatible) — chat/reasoning models
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4-flash

# Embeddings — Google Generative Language API.
# Router has NO embeddings endpoint (verified); gemini-embedding-001 is the
# GA model with its own free-tier quota bucket (100 RPM / 1K RPD).
EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_API_KEY=

# Exa search (discovery tier — engine, not needed for the spike)
EXA_API_KEY=

# Dedup thresholds (FR-4)
SIM_THRESHOLD_HIGH=0.82
SIM_THRESHOLD_LOW=0.65

# Memory (FR-6): prune events older than this many days
RETENTION_DAYS=365

# Discovery caps (FR-3): candidates per topic per run
MAX_CANDIDATES_PER_TOPIC=25

# Embedding pacing (free-tier quota: 100 RPM counts sub-requests)
EMBED_INTERVAL=20.0
EMBED_BATCH=25

# Coverage (FR-2): a topic with fewer feeds than this is a gap
MIN_FEEDS_PER_TOPIC=3

# Setup (FR-1): refuse to persist a blacklist that dropped below this fraction
# of the previously stored set (truncated-export guard)
MIN_BLACKLIST_RATIO=0.5

# Scheduling (FR-8): one recurring run; set weekly (0 7 * * 1) if daily yield is thin
RECURRING_CRON=0 6 * * *

# Eval-gate thresholds (r15): shared Config env surface so evals and the
# weekly pipeline cannot silently drift apart
EVAL_PASS_FRAC=0.75
EVAL_MAX_ARTICLES=4
EVAL_OVERVIEW_MIN_WORDS=50
EVAL_MIN_DECLARATIVE=2
EVAL_MAX_QUESTION_FRAC=0.35
EVAL_MIN_QUERIES=5
EVAL_QUERY_SLACK=2
EVAL_MAX_UNCOVERED=3

# FR-9 spike infrastructure (r21)
FETCH_WORKERS=12
FETCH_TIMEOUT=12
FEED_CAP_BYTES=300000
JUNK_TITLE_MARKERS=factsheet,fact sheet
LLM_MAX_TOKENS=8192

# Publish (FR-7): static host for the digest (netlify | github-pages)
PUBLISH_TARGET=netlify
DEPLOY_TOKEN=

# FR-9 weekly selection (spike constants moved here per PRD config table)
RECENCY_DAYS=7
MAX_PICKS_PER_SOURCE=3
MAX_ITEMS_PER_SOURCE=30
FETCH_TTL=21600
FAILURE_RETRY_TTL=86400
EVAL_INTERVAL=1.0
PROMPT_REV=9
STORY_MAX_ANGLES=5
STORY_MAX_QUESTIONS=8
